# Bu dosyayı .env olarak kopyalayıp değerleri doldurun.
DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/new_gen_test_db

# JWT imzalama anahtarı — üretmek için: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480

# production'da DATABASE_URL ve JWT_SECRET_KEY zorunlu olur
APP_ENV=development
